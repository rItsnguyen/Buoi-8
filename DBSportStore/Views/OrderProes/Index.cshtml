
@model IEnumerable<DBSportStore.Models.OrderPro>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2>Quản lý đơn hàng</h2>

<table class="table table-bordered table-striped">
    <tr>
        <th>Mã đơn hàng</th>
        <th>Ngày đặt</th>
        <th>Người nhận</th>
        <th>Số điện thoại</th>
        <th>Tổng tiền</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @item.OrderID
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>

            <td>
                @* Tạm hiển thị tên khách hàng nếu chưa có RecipientName *@
                @Html.DisplayFor(modelItem => item.RecipientName)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.ShippingPhone)
            </td>

            <td>
                @String.Format("{0:N0} VNĐ", item.TotalAmount)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>

            <td>
                @Html.ActionLink(
                    "Cập nhật trạng thái",
                    "Edit",
                    new { id = item.OrderID },
                    new { @class = "btn btn-primary btn-sm" }
                )
            </td>
        </tr>
    }
</table>