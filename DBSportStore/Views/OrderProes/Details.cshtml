@model DBSportStore.Models.OrderPro

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2>Chi tiết đơn hàng</h2>

<hr />

<h4>Thông tin đơn hàng</h4>

<table class="table table-bordered">
    <tr>
        <th>Mã đơn hàng</th>
        <td>@Model.OrderID</td>
    </tr>
    <tr>
        <th>Ngày đặt hàng</th>
        <td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
    </tr>
    <tr>
        <th>Trạng thái</th>
        <td>@Model.Status</td>
    </tr>
    <tr>
        <th>Tổng tiền</th>
        <td>@Model.TotalAmount.ToString("N0") VNĐ</td>
    </tr>
</table>

<h4>Thông tin người nhận</h4>

<table class="table table-bordered">
    <tr>
        <th>Họ tên</th>
        <td>@Model.RecipientName</td>
    </tr>
    <tr>
        <th>Số điện thoại</th>
        <td>@Model.ShippingPhone</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@(Model.Customer != null ? Model.Customer.Email : "")</td>
    </tr>
    <tr>
        <th>Địa chỉ giao hàng</th>
        <td>@Model.ShippingAddress</td>
    </tr>
</table>

<h4>Danh sách sản phẩm</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã sản phẩm</th>
            <th>Tên sản phẩm</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.OrderDetail)
        {
            <tr>
                <td>@item.ProductID</td>
                <td>
                    @(item.Product != null ? item.Product.ProductName : "Không có tên")
                </td>
                <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                <td>@item.Quantity</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("N0")) VNĐ</td>
            </tr>
        }
    </tbody>
</table>

<p>
    @Html.ActionLink("Quay lại danh sách", "Index",
        null, new { @class = "btn btn-default" })
</p>
